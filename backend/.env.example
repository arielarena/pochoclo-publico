# Copiá este archivo a ".env" y completá con tus valores reales.
# ".env" nunca se sube a git (ver .gitignore).

# Connection string de tu proyecto en Neon (Dashboard -> Connection Details).
# El sslmode que traiga pegado da igual: config/db.js lo saca de la cadena y
# decide el SSL en JavaScript (verificando el certificado). Es a propósito:
# ver los avisos de consola en backend/README.md.
DATABASE_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require

# Access Token v4 (de lectura) de TMDb. Se genera en:
# https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=tu_access_token_de_tmdb

PORT=3000

# --- Autenticación (v3) ---

# Clave con la que Better Auth firma y encripta las sesiones. Mínimo 32
# caracteres y con entropía real: generala, no la inventes a mano.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=generá_una_clave_de_32_bytes

# URL pública de este backend. En producción es el dominio real, no localhost.
#
# OBLIGATORIA: sin ella el servidor NO ARRANCA, a propósito. De esta variable
# cuelgan dos cosas de seguridad, y las dos se degradan en silencio si queda
# mal:
#   1. Si no empieza con https, la cookie de sesión sale sin `Secure`.
#   2. auth/correo.js la usa para saber si el sitio está publicado, y con eso
#      decide NO imprimir en el log los enlaces con token de un solo uso
#      (verificar correo, restablecer contraseña).
# Por eso no tiene valor por omisión: olvidársela al desplegar rompía las dos
# sin ningún aviso.
BETTER_AUTH_URL=http://localhost:3000

# Orígenes del frontend a los que se les permite usar la sesión
# (trustedOrigins de Better Auth y CORS con credenciales). Separados por coma.
# En desarrollo son dos: el servidor de Vite y el de "vite preview", contra el
# que corren la auditoría de accesibilidad y las pruebas de punta a punta.
URL_FRONTEND=http://localhost:5173,http://localhost:4173

# Cuántos proxies hay por delante de este server. En desarrollo, 0: Express usa
# la dirección real del socket y no le cree a ningún x-forwarded-for. Al
# publicar hay que poner el número de saltos reales (casi siempre 1), porque si
# no la IP de todos los visitantes es la del proxy y el límite de intentos de
# login deja de distinguirlos. Pasarse de número es peor que quedarse corto:
# deja que el cliente elija qué IP se le atribuye.
PROXIES_CONFIABLES=0

# --- Correo (verificación de cuenta y recuperación de contraseña) ---
#
# Mientras estas variables estén vacías NO se manda ningún mail: los enlaces
# se escriben en la consola del servidor, que alcanza para probar los dos
# flujos en desarrollo. El registro sigue funcionando igual.
#
# Sirve el SMTP de cualquier proveedor (Brevo, Zoho, Mailgun, Resend, el del
# hosting). Puerto 465 para TLS directo, 587 para STARTTLS.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
# Dirección desde la que salen los mails. Si se deja vacía se usa SMTP_USUARIO.
CORREO_REMITENTE=Pochoclo <no-responder@pochoclo.ar>

# Otras claves SMTP que hay que mantener vivas, separadas por coma.
#
# NO LAS USA EL SERVIDOR: las usa otro programa, y acá están solo para que el
# latido mensual las ejercite y el proveedor no las dé de baja por inactividad.
#
# El caso que las motivó es la clave que Gmail tiene guardada para poder
# responder desde contacto@pochoclo.ar ("Enviar como"). Si pasan 90 días sin
# contestarle a nadie, esa clave se muere sola, y uno se entera el día que
# necesita responder algo urgente, que suele ser un pedido de acceso o de
# supresión con plazo legal corriendo.
#
# El login es el mismo de arriba (SMTP_USUARIO): en Brevo el usuario es de la
# cuenta y cada clave es una contraseña distinta suya.
#
# Vacío es un estado válido: el latido manda solo el de la clave del backend.
SMTP_CLAVES_EXTRA=

# A dónde se manda el correo de latido del mantenimiento (mensual).
#
# POR QUÉ EXISTE ESE CORREO: los proveedores de SMTP vencen las claves por
# INACTIVIDAD además de por fecha (Brevo, a los 90 días sin uso), y Pochoclo
# manda mails en dos situaciones nada más. Un sitio tranquilo puede pasarse
# tres meses sin mandar ninguno y quedarse sin envío sin haber tocado nada, y
# el fallo es silencioso: el alta de la cuenta sigue funcionando y el mail
# simplemente no sale. Ver src/scripts/latidoCorreo.js.
#
# Si se deja vacía se usa la dirección que haya dentro de CORREO_REMITENTE,
# que existe por definición. Sin SMTP configurado no se manda nada y el
# mantenimiento no falla.
CORREO_LATIDO=

# Exigir el correo verificado para poder iniciar sesión.
#
# OJO CON EL ORDEN: primero configurar SMTP y comprobar que los mails llegan,
# y recién después poner esto en true. Encenderlo sin correo andando deja a
# todo el mundo sin poder entrar (el arranque lo corta con un error).
# Además, al encenderlo las cuentas que ya existan sin verificar no van a
# poder entrar hasta que verifiquen.
EXIGIR_CORREO_VERIFICADO=false

# OJO: ESA VARIABLE APAGA DOS COSAS, NO UNA.
#
# Además de no pedir la confirmación del correo, hace que el alta con una
# dirección QUE YA TIENE CUENTA conteste distinto que una con una dirección
# nueva. O sea que cualquiera puede averiguar qué correos tienen cuenta en
# Pochoclo probándolos de a uno.
#
# Las dos van juntas por necesidad y no por capricho de la librería: para que
# las dos respuestas sean idénticas, el alta no puede devolver una sesión (una
# sesión no se puede falsificar), y sin verificación el alta entra directo.
# No existe ninguna configuración que dé las dos cosas.
#
# Por eso el backend NO ARRANCA con la verificación apagada salvo que se diga
# explícitamente que se acepta ese riesgo. En desarrollo se acepta y ya está:
# no hay cuentas de nadie que proteger. **En producción esto va en false y
# EXIGIR_CORREO_VERIFICADO en true.**
PERMITIR_ENUMERACION_DE_CUENTAS=true

# --- HSTS (Strict-Transport-Security) ---
#
# Le dice al navegador que para este dominio nunca use HTTP. NO hace que el
# sitio sea HTTPS: eso lo da el certificado TLS del hosting. Solo se manda si
# el pedido llegó por HTTPS, así que en desarrollo no hace nada aunque esté
# configurado.
#
# OJO, ES UN COMPROMISO DIFÍCIL DE DESHACER: si el certificado se vence y el
# navegador ya recibió un max-age largo, el sitio queda inaccesible y el
# usuario no puede saltear el aviso, hasta que ese plazo se cumpla.
#
# Escalera recomendada, confirmando en cada paso que todo anda:
#   3600      una hora   (primer despliegue con HTTPS)
#   86400     un día
#   31536000  un año     (recién cuando ya no haya dudas)
# Vacío o 0 = apagado.
HSTS_MAX_AGE=

# Aplicar HSTS también a todos los subdominios. Ojo: si algún subdominio no
# tiene HTTPS, deja de ser accesible.
HSTS_INCLUIR_SUBDOMINIOS=false

# Pedir la inclusión en la lista de precarga de los navegadores (el registro se
# hace aparte, en hstspreload.org). Tapa el hueco de la primera visita, pero
# salir de la lista tarda meses. Exige HSTS_INCLUIR_SUBDOMINIOS=true y
# HSTS_MAX_AGE de al menos 31536000; con otra combinación el arranque corta.
HSTS_PRECARGA=false

# --- Verificación de contraseñas filtradas ---
#
# Antes de aceptar una contraseña se consulta a Have I Been Pwned si ya
# apareció en alguna filtración. NO se le manda la contraseña: se mandan los
# primeros 5 caracteres de su hash y se busca del lado nuestro (k-anonimato).
#
# Si el servicio no contesta, la contraseña se DEJA PASAR: nadie se queda sin
# poder registrarse porque un tercero está caído. En ese rato el piso lo pone
# la lista local de src/data/contrasenasComunes.js.
#
# Poner en "false" solo para pruebas sin internet.
VERIFICAR_CONTRASENAS_FILTRADAS=true
