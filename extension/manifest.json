{
  "manifest_version": 3,
  "name": "Pochoclo | Recomendaciones en plataformas de streaming",
  "version": "1.0.0",
  "description": "Recomienda algo para ver en la plataforma de streaming en la que ya estás, con tu sesión de pochoclo.ar y tus listas.",
  "key": "",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.pochoclo.ar/*"
  ],
  "externally_connectable": {
    "matches": ["https://pochoclo.ar/*"]
  },
  "optional_host_permissions": [
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://*.disneyplus.com/*",
    "https://*.hbomax.com/*",
    "https://*.max.com/*",
    "https://*.tv.apple.com/*"
  ],
  "icons": {
    "16": "iconos/16.png",
    "32": "iconos/32.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Pochoclo | Recomendaciones en plataformas de streaming",
    "default_icon": {
      "16": "iconos/16.png",
      "32": "iconos/32.png",
      "48": "iconos/48.png",
      "128": "iconos/128.png"
    }
  },
  "options_ui": {
    "page": "opciones.html",
    "open_in_tab": true
  }
}
